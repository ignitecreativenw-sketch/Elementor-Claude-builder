# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it,
# never paste it into a chat.
export PROJECT="client-slug"
export STAGING_URL="https://client.ignite-creative.agency"

# Route A: SSH + WP-CLI (preferred on 20i)
export SSH_HOST="user@ssh.stackcp.com"
export SSH_PORT="22"
export WP_PATH="/home/sites/xx/x/site.co.uk/public_html"

# Route B: REST API with an Application Password (no SSH on host)
export WP_URL="$STAGING_URL"
export WP_USER=""
export WP_APP_PASSWORD=""        # wp-admin -> Profile -> Application Passwords
