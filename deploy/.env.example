# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it,
# never paste it into a chat.
export PROJECT="client-slug"
export STAGING_URL="https://client.ignite-creative.agency"

# Website Core (the only route). The key from the site's "Copy for AI" block is used ONCE:
#   CORE_KEY=<pasted> python3 deploy/push_core.py --rotate
# then delete CORE_KEY here; the rotated key lives at $WEBSITE_CORE_HOME/<host>.key
# (it may also be kept in the client's Claude Project so later chats reuse it).
export CORE_URL="$STAGING_URL"
export WEBSITE_CORE_HOME="$HOME/.website-core"
# export CORE_KEY=""               # only for the one --rotate call

# Legacy routes (deploy/legacy/, not used): SSH_HOST, SSH_PORT, WP_PATH, WP_USER, WP_APP_PASSWORD
